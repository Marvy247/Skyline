# ─────────────────────────────────────────────────────────────────────────────
# Skyline dashboard — environment
#
# Copy to `.env.local` and fill in. Every variable is optional: with none of
# them set the dashboard runs in DEMO MODE from a published worked example.
#
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# Chain: 84532 = Base Sepolia, 1301 = Unichain Sepolia
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# ── Contract addresses (from the deployment script output) ──────────────────
NEXT_PUBLIC_HOOK_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=

# ── Pool parameters, used to derive the v4 PoolId on the client ────────────
# currency0 must be the lower of the two token addresses.
NEXT_PUBLIC_CURRENCY0=
NEXT_PUBLIC_CURRENCY1=
NEXT_PUBLIC_POOL_FEE=3000
NEXT_PUBLIC_TICK_SPACING=60

# ── Vault asset ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ASSET_DECIMALS=6
NEXT_PUBLIC_ASSET_SYMBOL=USDC

# ── Demo mode ───────────────────────────────────────────────────────────────
# "true"  → render the fixture from lib/demo-data.ts (no chain reads)
# "false" → always read the chain
# unset   → demo mode only when the addresses above are missing
#
# This is the Demo Day contingency. If the RPC or the chain misbehaves on
# stage, flip this to true and the dashboard still tells the story.
NEXT_PUBLIC_DEMO_MODE=false
